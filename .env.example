# ===== 复制为 .env 并填写真实值，.env 已在 .gitignore 中，绝不入库 =====

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ---- Judge 模型 ----
GEMINI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# ---- Hugging Face（可选，加速下载 / 访问 gated 模型）----
HF_HOME=./.cache/huggingface
HF_TOKEN=

# ---- 模型版本锁（必须固定到 commit hash，不要用 main）----
QWEN_BASE_REVISION=

# ---- 运行环境标识，写入每次推理记录 ----
RUN_ENV=local-wsl2
