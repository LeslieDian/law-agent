# ===== 复制为 .env 并填写真实值；.env 已在 .gitignore 中，绝不入库 =====

# ---- Neo4j（服务器上以 Docker 部署，见 docs/env_setup.md）----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lawagent2026claw
# 浏览器控制台： http://192.168.195.61:7474

# ---- Judge 模型（CLaw 官方用 Gemini-2.5-Pro + DeepSeek-R1 双评委）----
GEMINI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# ---- Hugging Face ----
# 本网络 huggingface.co 不可达，必须走镜像
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/mnt/data/lidian/.cache/huggingface
HF_TOKEN=

# ---- 模型版本锁（必须固定到 commit hash，禁止用 main）----
# 服务器本地权重路径（已下载并校验 sha256）
QWEN_BASE_MODEL=/mnt/data/lidian/law-agent/models/Qwen3-8B
QWEN_BASE_REVISION=
QWEN_EMB_MODEL=/mnt/data/lidian/law-agent/models/Qwen3-Embedding-0.6B
QWEN_EMB_REVISION=

# ---- 运行环境标识，写入每次推理记录 ----
# 服务器实际环境：Ubuntu 20.04 + 2×A800 80GB（不是论文原稿写的 WSL2/12GB）
RUN_ENV=server-a800-x2
RUN_DEVICE=cuda

# ---- 路径 ----
UV_CACHE_DIR=/mnt/data/lidian/.cache/uv
LAW_ROOT=/mnt/data/lidian/law-agent
